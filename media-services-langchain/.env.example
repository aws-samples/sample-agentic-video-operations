# Media Services LangChain — Environment Configuration
# Copy to .env and fill in your values before deploying/testing.

# AWS
AWS_PROFILE=your-profile
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012

# Model (Bedrock cross-region recommended)
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AgentCore Runtime ARNs (populated after cdk deploy)
COORDINATOR_ARN=arn:aws:bedrock-agentcore:us-west-2:<ACCOUNT_ID>:runtime/Coordinator_LangChain_...
EML_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:<ACCOUNT_ID>:runtime/EML_LangChain_...
EMX_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:<ACCOUNT_ID>:runtime/EMX_LangChain_...

# AgentCore Memory (populated after cdk deploy)
BEDROCK_AGENTCORE_MEMORY_ID=MediaServicesLangChain_...-xxxxx

# Demo pipeline resources (created manually or via CLI)
MEDIACONNECT_FLOW_ARN=arn:aws:mediaconnect:us-west-2:<ACCOUNT_ID>:flow:1-...:demo-srt-ingest
MEDIACONNECT_INPUT_ID=9554348
MEDIALIVE_CHANNEL_ID=5133350
MEDIALIVE_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/MediaLiveAccessRole
MEDIAPACKAGE_V2_INGEST_URL=https://xxx.ingest.xxx.mediapackagev2.us-west-2.amazonaws.com/in/v1/...
HLS_PLAYBACK_URL=https://xxx.egress.xxx.mediapackagev2.us-west-2.amazonaws.com/out/v1/.../index.m3u8

# SRT ingest (from MediaConnect flow)
SRT_INGEST_IP=0.0.0.0
SRT_INGEST_PORT=5000

# Non-Bedrock providers (optional — only if switching from Bedrock)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
