# Every generated file is listed here explicitly; nothing relies on a tool's own
# .gitignore. `just clean` removes them, and CI fails if a gate run leaves the
# working tree dirty.

# Secrets
.env
*.env.local
!/.env.example

# Tool caches and run output (ruff, mypy, pytest and the eval write under .cache/)
.cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# Agent session files: now under .cache/agentic-iops-sessions; .hub-sessions is the old default
.hub-sessions/
.coverage
htmlcov/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Node and CDK
node_modules/
**/cdk.out/

# Operating system and editor
.DS_Store
*.swp
.idea/
.vscode/

# Agent IDE: instructions are tracked; user-specific artifacts stay local
.kiro/*
.claude/plans/
.claude/steering/
.claude/contracts/collaboration-contract.md
