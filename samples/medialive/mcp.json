{
  "mcpServers": {
    "medialive": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/sample-agentic-video-operations",
        "--env-file",
        ".env",
        "--package",
        "medialive-mcp-server",
        "serve-medialive"
      ]
    },
    "medialive-demo": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/sample-agentic-video-operations",
        "--package",
        "medialive-mcp-server",
        "serve-medialive"
      ],
      "env": {
        "DEMO": "1"
      }
    }
  }
}
