AWS_REGION=us-west-2

# Optional deployment inputs. An empty bucket name uses cmcd-content-<account>.
# CMCD_ORIGIN_DOMAIN=example.com
# CMCD_S3_BUCKET_NAME=

INFLUXDB_URL=https://influxdb.example.com
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG=replace-with-influxdb-organization
VERIFY_SSL=true

DEMO=false
