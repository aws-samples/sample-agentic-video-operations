# Add these to the root .env (sample-contract §5). Models are chosen in the root .env.
AWS_REGION=us-west-2

MEMORY_ID=
MEDIALIVE_CHANNEL_ID=

ALLOW_WRITES=false
# Lets the Strands agent run model-written Python (code_mode). Keep false outside a sandbox.
ENABLE_CODE_MODE=false
DEMO=false
# Empty selects this sample's default fixture scenario, input_loss.
DEMO_SCENARIO=
APPROVAL_SIGNING_KEY=
