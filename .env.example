# AWS region used by local and deployed samples.
AWS_REGION=us-west-2

# Choose models once here. Every run and deployment uses these values.
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6
THUMBNAIL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
CHART_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Safe defaults. Enable writes only for an explicitly approved workflow.
ALLOW_WRITES=false
DEMO=false
# Each sample selects its own default scenario when this is empty.
DEMO_SCENARIO=
FIXTURES_DIR=fixtures
MEMORY_ID=
APPROVAL_SIGNING_KEY=

# HLS Doctor (samples/hls-doctor). All optional; the values shown are the defaults.
# Request timeout for playlist and segment probes, in seconds.
# HLS_TIMEOUT_SECONDS=10
# User-Agent sent with every probe.
# HLS_USER_AGENT=hls-doctor/0.1
# Upper bound for a live watch window, in seconds.
# HLS_MAX_WATCH_SECONDS=60
# Allow loopback/private fetch targets to diagnose a local stream. Refused in the container.
# HLS_ALLOW_PRIVATE_TARGETS=false

# agentic-iops-streaming (samples/agentic-iops-streaming). All optional; the values shown are the defaults.
# Domain packs the coordinator loads and deploys IAM for.
# MEDIA_DOMAINS=medialive,mediaconnect
# Tool calls allowed per request.
# AGENTIC_IOPS_TOOL_BUDGET=12
# Optional IAM scope for writes, as Key=Value. Only tagged channels and flows can be changed.
# AGENTIC_IOPS_WRITE_TAG=MediaOpsManaged=true
# The one IAM role `just deploy agentic-iops-streaming` attaches the runtime's invoke policy to.
# AGENTIC_IOPS_INVOKER_ROLE_NAME=
# Local session files, used when MEMORY_ID is empty.
# SESSION_DIR=.cache/agentic-iops-sessions
# `just run agentic-iops-streaming` sets this to true. Never set it for a deployed runtime.
# AGENTIC_IOPS_LOCAL_MODE=false
# Set by the agentic-iops-streaming CDK stack on the runtime; leave it empty locally.
# APPROVAL_SIGNING_KEY_SECRET_ARN=
# Inbound JWT authorization for `just deploy agentic-iops-streaming` (off when empty): the identity provider's
# OIDC discovery URL and the app client ids allowed to call. The actor is then the token's
# `sub`, and callers invoke with AGENTIC_IOPS_BEARER_TOKEN instead of IAM.
# AGENTIC_IOPS_JWT_DISCOVERY_URL=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration
# AGENTIC_IOPS_JWT_CLIENT_IDS=
# An access token for scripts/invoke_agentic_iops_streaming.py against a JWT-authorized runtime. Never commit it.
# AGENTIC_IOPS_BEARER_TOKEN=
# Set by the agentic-iops-streaming CDK stack on a JWT-authorized runtime only; never set them locally.
# AGENTIC_IOPS_JWT_ISSUER=
# AGENTIC_IOPS_JWT_ALLOWED_CLIENTS=

# Optional CMCD deployment inputs. An empty bucket name uses cmcd-content-<account>.
# CMCD_ORIGIN_DOMAIN=example.com
# CMCD_S3_BUCKET_NAME=
# CMCD_ARTIFACTS_BUCKET=

# MediaLive and MediaConnect defaults.
# MEDIALIVE_CHANNEL_ID=
# MEDIACONNECT_FLOW_ARN=

# CMCD live connection. `just cmcd-token` writes these without printing the token.
# INFLUXDB_URL=
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=
# INFLUXDB_BUCKET=cmcd-metrics
# VERIFY_SSL=true

# Hydrolix inputs and optional deployment outputs.
# HYDROLIX_TABLE=
# HYDROLIX_AMPLIFY_APP_ID=
# HYDROLIX_SECRET_ARN=
# QUESTION_ANSWERS_TABLE=

# Hydrolix inbound JWT authorization for `just deploy hydrolix` (off when empty: the runtime
# is then IAM-authorized and runs with memory off). The Cognito user pool's discovery URL
# and the web app client ids; the actor is then the access token's `sub`.
# HYDROLIX_JWT_DISCOVERY_URL=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration
# HYDROLIX_JWT_CLIENT_IDS=
# An access token for scripts/invoke_hydrolix.py against a JWT-authorized backend. Never commit it.
# HYDROLIX_BEARER_TOKEN=
# Set by the hydrolix CDK stack on a JWT-authorized runtime only; never set them locally.
# HYDROLIX_JWT_ISSUER=
# HYDROLIX_JWT_ALLOWED_CLIENTS=
