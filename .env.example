# AWS region used by local and deployed samples.
AWS_REGION=us-west-2

# Choose models once here. Every run and deployment uses these values.
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6
THUMBNAIL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
CHART_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Safe defaults. Enable writes only for an explicitly approved workflow.
ALLOW_WRITES=false
DEMO=false
MEMORY_ID=
APPROVAL_SIGNING_KEY=
