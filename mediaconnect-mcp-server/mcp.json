{
  "mcpServers": {
    "mediaconnect": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/sample-agentic-video-operations",
        "--env-file",
        ".env",
        "--package",
        "mediaconnect-mcp-server",
        "serve-mediaconnect"
      ]
    },
    "mediaconnect-demo": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/sample-agentic-video-operations",
        "--env-file",
        ".env",
        "--package",
        "mediaconnect-mcp-server",
        "serve-mediaconnect"
      ],
      "env": {
        "DEMO": "1",
        "DEMO_SCENARIO": "srt_packet_loss",
        "ALLOW_WRITES": "false"
      }
    }
  }
}
